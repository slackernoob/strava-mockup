{
  "name": "strava-mockup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply strava-mockup-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply strava-mockup-db --remote",
    "db:seed": "wrangler d1 execute strava-mockup-db --local --file ./seed.sql",
    "db:seed:remote": "wrangler d1 execute strava-mockup-db --remote --file ./seed.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.126.0"
  }
}
